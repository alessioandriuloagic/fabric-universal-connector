{
  "name": "fabric-developer-sample",
  "version": "2.0.0",
  "description": "Microsoft Fabric - Developer Sample App",
  "scripts": {
    "start": "npm run start:devServer",
    "start:devServer": "cross-env NODE_OPTIONS=--max-old-space-size=8192 env-cmd -f .env.dev webpack serve --open --config ./devServer/webpack.dev.js",
    "start:devGateway": "node ./devServer/start-devGateway.js",
    "start:codespace": "cross-env NODE_OPTIONS=--max-old-space-size=8192 env-cmd -f .env.dev webpack serve --open --config ./devServer/webpack.dev.js --no-hot",
    "build:test": "env-cmd -f .env.test webpack --config ./webpack.config.js --output-path ../build/Frontend --progress",
    "build:prod": "env-cmd -f .env.prod webpack --config ./webpack.config.js --output-path ../build/Frontend --mode production --progress",
    "build:customer-insight-journey:dev": "cross-env REACT_APP_WORKLOAD_ID=customer-insight-journey env-cmd --no-override -f .env.dev webpack --config ./webpack.config.js --output-path ../build/Frontend --progress",
    "build:customer-insight-journey:prod": "cross-env REACT_APP_WORKLOAD_ID=customer-insight-journey env-cmd --no-override -f .env.prod webpack --config ./webpack.config.js --output-path ../build/Frontend --mode production --progress",
    "start:customer-insight-journey": "cross-env REACT_APP_WORKLOAD_ID=customer-insight-journey NODE_OPTIONS=--max-old-space-size=8192 env-cmd --no-override -f .env.dev webpack serve --open --config ./devServer/webpack.dev.js",
    "start:business-central": "cross-env REACT_APP_WORKLOAD_ID=business-central NODE_OPTIONS=--max-old-space-size=8192 env-cmd --no-override -f .env.dev webpack serve --open --config ./devServer/webpack.dev.js",
    "start:sales-crm": "cross-env REACT_APP_WORKLOAD_ID=sales-crm NODE_OPTIONS=--max-old-space-size=8192 env-cmd --no-override -f .env.dev webpack serve --open --config ./devServer/webpack.dev.js",
    "start:sql-db": "cross-env REACT_APP_WORKLOAD_ID=sql-db NODE_OPTIONS=--max-old-space-size=8192 env-cmd --no-override -f .env.dev webpack serve --open --config ./devServer/webpack.dev.js",
    "build:business-central:dev": "cross-env REACT_APP_WORKLOAD_ID=business-central env-cmd --no-override -f .env.dev webpack --config ./webpack.config.js --output-path ../build/Frontend --progress",
    "build:business-central:prod": "cross-env REACT_APP_WORKLOAD_ID=business-central env-cmd --no-override -f .env.prod webpack --config ./webpack.config.js --output-path ../build/Frontend --mode production --progress",
    "build:sales-crm:dev": "cross-env REACT_APP_WORKLOAD_ID=sales-crm env-cmd --no-override -f .env.dev webpack --config ./webpack.config.js --output-path ../build/Frontend --progress",
    "build:sales-crm:prod": "cross-env REACT_APP_WORKLOAD_ID=sales-crm env-cmd --no-override -f .env.prod webpack --config ./webpack.config.js --output-path ../build/Frontend --mode production --progress",
    "build:sql-db:dev": "cross-env REACT_APP_WORKLOAD_ID=sql-db env-cmd --no-override -f .env.dev webpack --config ./webpack.config.js --output-path ../build/Frontend --progress",
    "build:sql-db:prod": "cross-env REACT_APP_WORKLOAD_ID=sql-db env-cmd --no-override -f .env.prod webpack --config ./webpack.config.js --output-path ../build/Frontend --mode production --progress",
    "test": "jest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fluentui/react-components": "^9.7.2",
    "@fluentui/react-icons": "2.0.226",
    "@ms-fabric/workload-client": "^3.1.1",
    "@reduxjs/toolkit": "^2.6.0",
    "history": "^4.9.0",
    "i18next": "^25.4.1",
    "i18next-http-backend": "^2.4.2",
    "jwt-decode": "^3.1.2",
    "process": "^0.11.10",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-i18next": "^15.0.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^5.3.4",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^16.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-router-dom": "^5.3.2",
    "ajv": "^8.12.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^10.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.5.1",
    "dotenv": "^16.4.5",
    "env-cmd": "^10.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nuget-bin": "^4.0.0",
    "sass": "^1.79.3",
    "sass-loader": "^16.0.2",
    "style-loader": "^3.3.1",
    "ts-jest": "^29.4.10",
    "ts-loader": "^9.2.6",
    "typescript": "^5.0.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.7.0",
    "webpack-merge": "^6.0.1"
  }
}

# Customer Insight Journey — per-workload environment template
#
# Copy this file to .env.dev (local) and .env.prod (production), then fill in
# the real values.  Both files are gitignored (.env.* pattern in root .gitignore).
#
# These values OVERRIDE the base Workload/.env.{dev|prod} during BuildWorkload.ps1.
# Values not listed here are inherited from the base env file.
#
# Usage:
#   cp env.example .env.dev   && fill in dev values
#   cp env.example .env.prod  && fill in prod values
#
#   Build prod release:
#     .\scripts\Build\BuildWorkload.ps1 -Workload customer-insight-journey -Environment prod
#
#   Local dev (CIJ mode):
#     cd Workload && npm run start:customer-insight-journey

# ── Workload identity ──────────────────────────────────────────────
# Must match the workload registration in Fabric Admin Portal
WORKLOAD_NAME=Org.CustomerInsightJourney
WORKLOAD_VERSION=1.0.0

# Items exposed by this workload (do not include HelloWorld — not part of CIJ)
ITEM_NAMES=Connector

# ── Frontend App Registration ──────────────────────────────────────
# One App Registration per workload (separate from the Universal Connector)
# Create in Entra ID -> App Registrations -> New registration
FRONTEND_APPID=00000000-0000-0000-0000-000000000000

# Hosting URL for this workload's frontend
# dev:  http://localhost:3000
# prod: https://cij.connector.agic.technology
FRONTEND_URL=https://cij.connector.agic.technology

# ── Workload ID (do not change) ────────────────────────────────────
# Injected automatically by BuildWorkload.ps1 — listed here for documentation
REACT_APP_WORKLOAD_ID=customer-insight-journey
